# Port (Provided automatically by Render, defaults to 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rkd_school?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Allowed Frontend URL on Vercel (e.g. https://rkd-school.vercel.app)
FRONTEND_URL=https://your-frontend-domain.vercel.app
